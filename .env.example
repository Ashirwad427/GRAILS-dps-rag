# Required: Hugging Face User Access Token
# Create a token with Inference Providers permission.
HF_TOKEN=hf_your_token_here

# Hosted instruction model used for the Data Protection Profile.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Let Hugging Face select an available inference provider.
HF_PROVIDER=auto

# Embedding model for local vector search.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG settings.
TOP_K=5
MAX_NEW_TOKENS=900
TEMPERATURE=0.0
